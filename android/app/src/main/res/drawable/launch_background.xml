<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by Android before the Flutter engine renders its first frame. Matching
     it to the in-app splash avoids the white flash between the two. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_green"/>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo"/>
    </item>
</layer-list>
