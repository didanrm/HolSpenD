<?xml version="1.0" encoding="utf-8"?>
<!-- Needed as its own bucket: night mode outranks platform version in resource
     resolution, so a dark-mode phone on API 31+ would pick values-night and lose
     the splash-screen settings declared in values-v31. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <!-- Without this the system falls back to the launcher icon, which it
             masks into a circle over a teal plate — a different-looking opening
             than the white screen SplashScreen hands over to. splash_icon is
             already inset to survive that circular clip. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
